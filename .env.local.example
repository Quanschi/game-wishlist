# Kopiere diese Datei zu ".env.local" und trage deine eigenen Werte ein.
# ".env.local" wird NIE eingecheckt (siehe .gitignore).

# --- Datenbank ---
# Lokale Entwicklung: einfach eine Datei auf der Platte
DATABASE_URL=file:local.db
# Produktion (z.B. Turso, https://turso.tech, kostenloser Tarif reicht locker):
# DATABASE_URL=libsql://<dein-db-name>.turso.io
# DATABASE_AUTH_TOKEN=<dein-turso-token>

# --- Sessions ---
# Beliebiger langer Zufallsstring, z.B. erzeugt mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- Die zwei Accounts ---
# Wähle selbst frei erfundene Benutzernamen (keine echten Namen nötig).
# Passwort-Hash (base64-kodiert) erzeugst du lokal mit:
#   node scripts/hash-password.mjs "DeinPasswort"
AUTH_USER_1_ID=spieler1
AUTH_USER_1_PASSWORD_HASH_B64=
AUTH_USER_2_ID=spieler2
AUTH_USER_2_PASSWORD_HASH_B64=

# --- Push-Benachrichtigungen (Web Push) ---
# Erzeugen mit: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:deine-email@example.com

# --- Täglicher Preis-Check (Vercel Cron) ---
# Beliebiger langer Zufallsstring, schützt den Cron-Endpunkt vor fremden Aufrufen.
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# --- gg.deals-Link (optional) ---
# Kostenloser API-Key: auf gg.deals einloggen -> Einstellungen -> API-Key generieren.
# Ohne diesen Key wird einfach kein "Auf gg.deals ansehen"-Link angezeigt.
GG_DEALS_API_KEY=
